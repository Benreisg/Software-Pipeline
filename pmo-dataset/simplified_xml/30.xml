<definitions Definitions_1>
    <process Process_1>
        <task User_1 (Send invites to 10 people)/>
        <task User_2 (Ask which games do they want to play)/>
        <task User_3 (Appoint a date)/>
        <task User_4 (Ask friends how much beer they would like)/>
        <task User_5 (Order beer for that date)/>
        <task User_6 (Find where can you download the games)/>
        <task Service_1 (Reserve that day)/>
        <task Service_2 (Download the missing games)/>
        <task Service_3 (Send a notification that the LAN party will be held on that date)/>
        <startNoneEvent StartNoneEvent_1 (Wish for a LAN gameparty)/>
        <endNoneEvent EndNoneEvent_1 (LAN party done)/>
        <intermediateTimerEvent IntermediateTimerEvent_1 (Few hours, until the user has all the games that they want to play)/>
        <intermediateTimerEvent IntermediateTimerEvent_2 (Few hours, until all people reply if they can play on that date)/>
        <intermediateTimerEvent IntermediateTimerEvent_3 (Few hours, until all people reply with t he amount of beer)/>
        <exclusivegatewayGateway ExclusiveGateway_1 (How many people can play on that date?)/>
        <exclusivegatewayGateway ExclusiveGateway_2 (Do we have all the games?)/>
        <exclusivegatewayGateway ExclusiveGateway_3/>
        <exclusivegatewayGateway ExclusiveGateway_4 (Do you have enough beer?)/>
        <exclusivegatewayGateway ExclusiveGateway_5/>
        <exclusivegatewayGateway ExclusiveGateway_6 (Download successful?)/>
        <parallelgatewayGateway ParallelGateway_1/>
        <parallelgatewayGateway ParallelGateway_2/>
        <sequenceFlow SequenceFlow_1>
          - sourceRef: StartNoneEvent_1
          - targetRef: User_1
        </sequenceFlow>
        <sequenceFlow SequenceFlow_2>
          - sourceRef: User_1
          - targetRef: User_2
        </sequenceFlow>
        <sequenceFlow SequenceFlow_3>
          - sourceRef: User_2
          - targetRef: IntermediateTimerEvent_1
        </sequenceFlow>
        <sequenceFlow SequenceFlow_4>
          - sourceRef: IntermediateTimerEvent_1
          - targetRef: ParallelGateway_1
        </sequenceFlow>
        <sequenceFlow SequenceFlow_5>
          - sourceRef: ParallelGateway_1
          - targetRef: User_3
        </sequenceFlow>
        <sequenceFlow SequenceFlow_6>
          - sourceRef: ParallelGateway_1
          - targetRef: ExclusiveGateway_2
        </sequenceFlow>
        <sequenceFlow SequenceFlow_7>
          - sourceRef: User_3
          - targetRef: IntermediateTimerEvent_2
        </sequenceFlow>
        <sequenceFlow SequenceFlow_8>
          - sourceRef: IntermediateTimerEvent_2
          - targetRef: ExclusiveGateway_1
        </sequenceFlow>
        <sequenceFlow SequenceFlow_9> (Less then 8 people can play on that date)
          - sourceRef: ExclusiveGateway_1
          - targetRef: User_3
        </sequenceFlow>
        <sequenceFlow SequenceFlow_10> (8 or more people can play on that date)
          - sourceRef: ExclusiveGateway_1
          - targetRef: Service_1
        </sequenceFlow>
        <sequenceFlow SequenceFlow_11>
          - sourceRef: ParallelGateway_2
          - targetRef: User_4
        </sequenceFlow>
        <sequenceFlow SequenceFlow_12>
          - sourceRef: User_4
          - targetRef: IntermediateTimerEvent_3
        </sequenceFlow>
        <sequenceFlow SequenceFlow_13> (No)
          - sourceRef: ExclusiveGateway_4
          - targetRef: User_5
        </sequenceFlow>
        <sequenceFlow SequenceFlow_14>
          - sourceRef: User_5
          - targetRef: ExclusiveGateway_5
        </sequenceFlow>
        <sequenceFlow SequenceFlow_15> (No)
          - sourceRef: ExclusiveGateway_2
          - targetRef: User_6
        </sequenceFlow>
        <sequenceFlow SequenceFlow_16>
          - sourceRef: User_6
          - targetRef: Service_2
        </sequenceFlow>
        <sequenceFlow SequenceFlow_17>
          - sourceRef: Service_3
          - targetRef: EndNoneEvent_1
        </sequenceFlow>
        <sequenceFlow SequenceFlow_18>
          - sourceRef: Service_1
          - targetRef: ParallelGateway_2
        </sequenceFlow>
        <sequenceFlow SequenceFlow_19> (Yes)
          - sourceRef: ExclusiveGateway_6
          - targetRef: ExclusiveGateway_3
        </sequenceFlow>
        <sequenceFlow SequenceFlow_20> (No)
          - sourceRef: ExclusiveGateway_6
          - targetRef: Service_2
        </sequenceFlow>
        <sequenceFlow SequenceFlow_21>
          - sourceRef: ExclusiveGateway_5
          - targetRef: Service_3
        </sequenceFlow>
        <sequenceFlow SequenceFlow_22>
          - sourceRef: IntermediateTimerEvent_3
          - targetRef: ExclusiveGateway_4
        </sequenceFlow>
        <sequenceFlow SequenceFlow_23> (Yes)
          - sourceRef: ExclusiveGateway_4
          - targetRef: ExclusiveGateway_5
        </sequenceFlow>
        <sequenceFlow SequenceFlow_24>
          - sourceRef: ExclusiveGateway_3
          - targetRef: ParallelGateway_2
        </sequenceFlow>
        <sequenceFlow SequenceFlow_25> (Yes)
          - sourceRef: ExclusiveGateway_2
          - targetRef: ExclusiveGateway_3
        </sequenceFlow>
        <sequenceFlow SequenceFlow_26>
          - sourceRef: Service_2
          - targetRef: ExclusiveGateway_6
        </sequenceFlow>
    </process>
</definitions>