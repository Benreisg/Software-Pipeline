        <task Manual_4 (customer saves product)/>
        <task Manual_5 (customer checks if product was already selected)/>
        <task Manual_6 (customer enters payment data)/>
        <task Manual_7 (customer enters shipping address)/>
        <task Manual_8 (customer enters an independent billing adress)/>
        <startNoneEvent StartNoneEvent_1 (Open E-Shop Homepage)/>
        <endNoneEvent EndNoneEvent_1 (Close E-Shop Homepage)/>
        <exclusivegatewayGateway ExclusiveGateway_1 (succesful login?)/>
        <exclusivegatewayGateway ExclusiveGateway_2 (has customer selected all desired products?)/>
