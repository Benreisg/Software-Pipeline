    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_2" targetRef="EndEvent_1"/>
  </process>
