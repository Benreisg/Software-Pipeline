    <sequenceFlow id="SequenceFlow_1" sourceRef="GEN_StartEvent_1" targetRef="GEN_Task_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="GEN_Task_1" targetRef="GEN_ExclusiveGateway_1"/>
