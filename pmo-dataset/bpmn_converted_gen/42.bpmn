<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" name="42" isExecutable="false">
    <task id="GEN_Task_1" name="Rate Service Facility">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </task>
    <task id="GEN_Task_2" name="Confirm that fridge is okay">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <task id="GEN_Task_3" name="Send a report to the fridge service center">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <task id="GEN_Task_4" name="Select local service facility">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <task id="GEN_Task_5" name="Schedule an appointment for fridge repair">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <task id="GEN_Task_6" name="Repair the fridge">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <task id="GEN_Task_7" name="Describe the symptoms">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <task id="GEN_Task_8" name="Collect fridge type data">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <exclusiveGateway id="GEN_ExclusiveGateway_1" name="Submit a rating?">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_2" name="Additional parts needed?">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_18</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_3" name="X">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <parallelGateway id="GEN_ParallelGateway_1" name="+">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </parallelGateway>
    <parallelGateway id="GEN_ParallelGateway_2" name="+">
      <incoming>SequenceFlow_13</incoming>
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </parallelGateway>
    <endEvent id="GEN_EndEvent_1" name="Repair process over">
      <incoming>SequenceFlow_1</incoming>
      <incoming>SequenceFlow_17</incoming>
    </endEvent>
    <intermediateCatchEvent id="GEN_IntermediateCatchEvent_1" name="Wait until service facility arrives">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </intermediateCatchEvent>
    <startEvent id="GEN_StartEvent_1" name="Fridge makes strange noises">
      <outgoing>SequenceFlow_16</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="GEN_Task_1" targetRef="GEN_EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="GEN_Task_2" targetRef="GEN_ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="GEN_Task_3" targetRef="GEN_Task_4"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="GEN_Task_5" targetRef="GEN_IntermediateCatchEvent_1"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="GEN_IntermediateCatchEvent_1" targetRef="GEN_Task_6"/>
