<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" name="52" isExecutable="false">
    <task id="GEN_Task_1" name="MPON sents the dismissal to the MPOO">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <task id="GEN_Task_2" name="MPOO reviews the dismissal">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <task id="GEN_Task_3" name="MPOO opposes the dismissal">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <task id="GEN_Task_4" name="MPOO confirmes the dismissal">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <exclusiveGateway id="GEN_ExclusiveGateway_1" name="X">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_2" name="X">
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <startEvent id="GEN_StartEvent_1" name="">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="GEN_EndEvent_1" name="">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="GEN_StartEvent_1" targetRef="GEN_Task_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="GEN_Task_1" targetRef="GEN_Task_2"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="GEN_Task_2" targetRef="GEN_ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_Task_3"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_Task_4"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="GEN_Task_3" targetRef="GEN_ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="GEN_Task_4" targetRef="GEN_ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="GEN_ExclusiveGateway_2" targetRef="GEN_EndEvent_1"/>
  </process>
</definitions>
