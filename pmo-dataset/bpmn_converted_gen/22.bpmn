    <sequenceFlow id="SequenceFlow_17" sourceRef="GEN_EventBasedGateway_1" targetRef="GEN_IntermediateCatchEvent_3"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="GEN_IntermediateCatchEvent_3" targetRef="GEN_Task_8"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="GEN_Task_8" targetRef="GEN_Task_9"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="GEN_Task_9" targetRef="GEN_EndEvent_4"/>
  </process>
