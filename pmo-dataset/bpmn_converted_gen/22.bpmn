<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" name="22" isExecutable="false">
    <task id="GEN_Task_1" name="check case">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <task id="GEN_Task_2" name="send request for payment">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <task id="GEN_Task_3" name="close case">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <task id="GEN_Task_4" name="send reminder">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <task id="GEN_Task_5" name="check reasoning">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <task id="GEN_Task_6" name="close case">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <task id="GEN_Task_7" name="hand over to collection agency">
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <task id="GEN_Task_8" name="make booking">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </task>
    <task id="GEN_Task_9" name="close case">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_20</outgoing>
    </task>
    <exclusiveGateway id="GEN_ExclusiveGateway_1" name="recourse possible?">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <eventBasedGateway id="GEN_EventBasedGateway_1" name="E">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
    </eventBasedGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_2" name="OK?">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_15</outgoing>
    </exclusiveGateway>
    <startEvent id="GEN_StartEvent_1" name="probable recourse detected">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="GEN_EndEvent_1" name="case closed">
      <incoming>SequenceFlow_5</incoming>
    </endEvent>
    <intermediateCatchEvent id="GEN_IntermediateCatchEvent_1" name="disagreement letter received">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </intermediateCatchEvent>
    <endEvent id="GEN_EndEvent_2" name="case closed">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
    <intermediateCatchEvent id="GEN_IntermediateCatchEvent_2" name="Reminder is due">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </intermediateCatchEvent>
    <endEvent id="GEN_EndEvent_3" name="case open">
      <incoming>SequenceFlow_16</incoming>
    </endEvent>
    <intermediateCatchEvent id="GEN_IntermediateCatchEvent_3" name="Money received">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </intermediateCatchEvent>
    <endEvent id="GEN_EndEvent_4" name="case closed">
      <incoming>SequenceFlow_20</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="GEN_StartEvent_1" targetRef="GEN_Task_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="GEN_Task_1" targetRef="GEN_ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_Task_2"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_Task_3"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="GEN_Task_3" targetRef="GEN_EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="GEN_Task_2" targetRef="GEN_Task_4"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="GEN_Task_4" targetRef="GEN_EventBasedGateway_1"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="GEN_EventBasedGateway_1" targetRef="GEN_IntermediateCatchEvent_1"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="GEN_IntermediateCatchEvent_1" targetRef="GEN_Task_5"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="GEN_Task_5" targetRef="GEN_ExclusiveGateway_2"/>
