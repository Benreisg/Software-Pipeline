<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="GEN_Process_1">
    <userTask id="GEN_UserTask_1" name="Send invites to 10 people">
      <incoming>GEN_SequenceFlow_1</incoming>
      <outgoing>GEN_SequenceFlow_2</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_2" name="Ask which games do they want to play">
      <incoming>GEN_SequenceFlow_2</incoming>
      <outgoing>GEN_SequenceFlow_3</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_3" name="Appoint a date">
      <incoming>GEN_SequenceFlow_5</incoming>
      <incoming>GEN_SequenceFlow_9</incoming>
      <outgoing>GEN_SequenceFlow_7</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_4" name="Ask friends how much beer they would like">
      <incoming>GEN_SequenceFlow_11</incoming>
      <outgoing>GEN_SequenceFlow_12</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_5" name="Order beer for that date">
      <incoming>GEN_SequenceFlow_13</incoming>
      <outgoing>GEN_SequenceFlow_14</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_6" name="Find where can you download the games">
      <incoming>GEN_SequenceFlow_15</incoming>
      <outgoing>GEN_SequenceFlow_16</outgoing>
    </userTask>
    <serviceTask id="GEN_ServiceTask_1" name="Reserve that day">
      <incoming>GEN_SequenceFlow_10</incoming>
      <outgoing>GEN_SequenceFlow_18</outgoing>
    </serviceTask>
    <serviceTask id="GEN_ServiceTask_2" name="Download the missing games">
      <incoming>GEN_SequenceFlow_16</incoming>
      <incoming>GEN_SequenceFlow_20</incoming>
      <outgoing>GEN_SequenceFlow_26</outgoing>
    </serviceTask>
    <serviceTask id="GEN_ServiceTask_3" name="Send a notification that the LAN party will be held on that date">
      <incoming>GEN_SequenceFlow_21</incoming>
      <outgoing>GEN_SequenceFlow_17</outgoing>
    </serviceTask>
    <exclusiveGateway id="GEN_ExclusiveGateway_1" name="How many people can play on that date?">
      <incoming>GEN_SequenceFlow_8</incoming>
      <outgoing>GEN_SequenceFlow_9</outgoing>
      <outgoing>GEN_SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_2" name="Do we have all the games?">
      <incoming>GEN_SequenceFlow_6</incoming>
      <outgoing>GEN_SequenceFlow_15</outgoing>
      <outgoing>GEN_SequenceFlow_25</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_3">
      <incoming>GEN_SequenceFlow_19</incoming>
      <incoming>GEN_SequenceFlow_25</incoming>
      <outgoing>GEN_SequenceFlow_24</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_4" name="Do you have enough beer?">
      <incoming>GEN_SequenceFlow_22</incoming>
      <outgoing>GEN_SequenceFlow_13</outgoing>
      <outgoing>GEN_SequenceFlow_23</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_5">
      <incoming>GEN_SequenceFlow_14</incoming>
      <incoming>GEN_SequenceFlow_23</incoming>
      <outgoing>GEN_SequenceFlow_21</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_6" name="Download successful?">
      <incoming>GEN_SequenceFlow_26</incoming>
      <outgoing>GEN_SequenceFlow_19</outgoing>
      <outgoing>GEN_SequenceFlow_20</outgoing>
    </exclusiveGateway>
    <parallelGateway id="GEN_ParallelGateway_1">
      <incoming>GEN_SequenceFlow_4</incoming>
      <outgoing>GEN_SequenceFlow_5</outgoing>
      <outgoing>GEN_SequenceFlow_6</outgoing>
    </parallelGateway>
    <parallelGateway id="GEN_ParallelGateway_2">
      <incoming>GEN_SequenceFlow_18</incoming>
      <incoming>GEN_SequenceFlow_24</incoming>
      <outgoing>GEN_SequenceFlow_11</outgoing>
    </parallelGateway>
    <startEvent id="GEN_StartEvent_1" name="Wish for a LAN gameparty">
      <outgoing>GEN_SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="GEN_EndEvent_1" name="LAN party done">
      <incoming>GEN_SequenceFlow_17</incoming>
    </endEvent>
    <intermediateCatchEvent id="GEN_IntermediateCatchEvent_1" name="Few hours, until the user has all the games that they want to play">
      <timerEventDefinition id="GEN_timer_1"/>
      <incoming>GEN_SequenceFlow_3</incoming>
      <outgoing>GEN_SequenceFlow_4</outgoing>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="GEN_IntermediateCatchEvent_2" name="Few hours, until all people reply if they can play on that date">
      <timerEventDefinition id="GEN_timer_2"/>
      <incoming>GEN_SequenceFlow_7</incoming>
      <outgoing>GEN_SequenceFlow_8</outgoing>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="GEN_IntermediateCatchEvent_3" name="Few hours, until all people reply with t he amount of beer">
      <timerEventDefinition id="GEN_timer_3"/>
      <incoming>GEN_SequenceFlow_12</incoming>
      <outgoing>GEN_SequenceFlow_22</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="GEN_SequenceFlow_1" sourceRef="GEN_StartEvent_1" targetRef="GEN_UserTask_1"/>
    <sequenceFlow id="GEN_SequenceFlow_2" sourceRef="GEN_UserTask_1" targetRef="GEN_UserTask_2"/>
    <sequenceFlow id="GEN_SequenceFlow_3" sourceRef="GEN_UserTask_2" targetRef="GEN_IntermediateCatchEvent_1"/>
    <sequenceFlow id="GEN_SequenceFlow_4" sourceRef="GEN_IntermediateCatchEvent_1" targetRef="GEN_ParallelGateway_1"/>
    <sequenceFlow id="GEN_SequenceFlow_5" sourceRef="GEN_ParallelGateway_1" targetRef="GEN_UserTask_3"/>
    <sequenceFlow id="GEN_SequenceFlow_6" sourceRef="GEN_ParallelGateway_1" targetRef="GEN_ExclusiveGateway_2"/>
    <sequenceFlow id="GEN_SequenceFlow_7" sourceRef="GEN_UserTask_3" targetRef="GEN_IntermediateCatchEvent_2"/>
    <sequenceFlow id="GEN_SequenceFlow_8" sourceRef="GEN_IntermediateCatchEvent_2" targetRef="GEN_ExclusiveGateway_1"/>
    <sequenceFlow id="GEN_SequenceFlow_9" name="Less then 8 people can play on that date" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_UserTask_3"/>
    <sequenceFlow id="GEN_SequenceFlow_10" name="8 or more people can play on that date" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_ServiceTask_1"/>
    <sequenceFlow id="GEN_SequenceFlow_11" sourceRef="GEN_ParallelGateway_2" targetRef="GEN_UserTask_4"/>
    <sequenceFlow id="GEN_SequenceFlow_12" sourceRef="GEN_UserTask_4" targetRef="GEN_IntermediateCatchEvent_3"/>
    <sequenceFlow id="GEN_SequenceFlow_13" name="No" sourceRef="GEN_ExclusiveGateway_4" targetRef="GEN_UserTask_5"/>
    <sequenceFlow id="GEN_SequenceFlow_14" sourceRef="GEN_UserTask_5" targetRef="GEN_ExclusiveGateway_5"/>
    <sequenceFlow id="GEN_SequenceFlow_15" name="No" sourceRef="GEN_ExclusiveGateway_2" targetRef="GEN_UserTask_6"/>
    <sequenceFlow id="GEN_SequenceFlow_16" sourceRef="GEN_UserTask_6" targetRef="GEN_ServiceTask_2"/>
    <sequenceFlow id="GEN_SequenceFlow_17" sourceRef="GEN_ServiceTask_3" targetRef="GEN_EndEvent_1"/>
    <sequenceFlow id="GEN_SequenceFlow_18" sourceRef="GEN_ServiceTask_1" targetRef="GEN_ParallelGateway_2"/>
    <sequenceFlow id="GEN_SequenceFlow_19" name="Yes" sourceRef="GEN_ExclusiveGateway_6" targetRef="GEN_ExclusiveGateway_3"/>
    <sequenceFlow id="GEN_SequenceFlow_20" name="No" sourceRef="GEN_ExclusiveGateway_6" targetRef="GEN_ServiceTask_2"/>
    <sequenceFlow id="GEN_SequenceFlow_21" sourceRef="GEN_ExclusiveGateway_5" targetRef="GEN_ServiceTask_3"/>
    <sequenceFlow id="GEN_SequenceFlow_22" sourceRef="GEN_IntermediateCatchEvent_3" targetRef="GEN_ExclusiveGateway_4"/>
    <sequenceFlow id="GEN_SequenceFlow_23" name="Yes" sourceRef="GEN_ExclusiveGateway_4" targetRef="GEN_ExclusiveGateway_5"/>
    <sequenceFlow id="GEN_SequenceFlow_24" sourceRef="GEN_ExclusiveGateway_3" targetRef="GEN_ParallelGateway_2"/>
    <sequenceFlow id="GEN_SequenceFlow_25" name="Yes" sourceRef="GEN_ExclusiveGateway_2" targetRef="GEN_ExclusiveGateway_3"/>
    <sequenceFlow id="GEN_SequenceFlow_26" sourceRef="GEN_ServiceTask_2" targetRef="GEN_ExclusiveGateway_6"/>
  </process>
