    </startEvent>
    <endEvent id="GEN_EndEvent_1" name="Shipment prepared">
      <incoming>GEN_SequenceFlow_16</incoming>
    </endEvent>
    <sequenceFlow id="GEN_SequenceFlow_1" name="no" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_InclusiveGateway_1"/>
    <sequenceFlow id="GEN_SequenceFlow_2" name="If insurance necessary" sourceRef="GEN_InclusiveGateway_1" targetRef="GEN_Task_1"/>
