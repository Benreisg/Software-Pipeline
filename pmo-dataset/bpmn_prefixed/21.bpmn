  <collaboration id="GEN_Collaboration_1">
    <participant id="GEN_Participant_1" name="Dispatch of goods Computer Hardware Shop" processRef="GEN_Process_1"/>
  </collaboration>
  <process id="GEN_Process_1">
    <laneSet id="GEN_LaneSet_1">
      <lane id="GEN_Lane_1" name="Logistics">
        <flowNodeRef>GEN_Task_1</flowNodeRef>
      </lane>
      <lane id="GEN_Lane_2" name="Secretary">
        <flowNodeRef>GEN_Task_2</flowNodeRef>
