      </lane>
      <lane id="GEN_Lane_3" name="Warehouse">
        <flowNodeRef>GEN_Task_6</flowNodeRef>
        <flowNodeRef>GEN_Task_7</flowNodeRef>
        <flowNodeRef>GEN_ExclusiveGateway_3</flowNodeRef>
        <flowNodeRef>GEN_EndEvent_1</flowNodeRef>
      </lane>
    </laneSet>
    <task id="GEN_Task_1" name="Insure parcel">
      <incoming>GEN_SequenceFlow_2</incoming>
      <outgoing>GEN_SequenceFlow_5</outgoing>
    </task>
    <task id="GEN_Task_2" name="Write package label">
      <incoming>GEN_SequenceFlow_3</incoming>
      <outgoing>GEN_SequenceFlow_4</outgoing>
    </task>
    <task id="GEN_Task_3" name="Clarify shipment method">
      <incoming>GEN_SequenceFlow_7</incoming>
      <outgoing>GEN_SequenceFlow_8</outgoing>
    </task>
    <task id="GEN_Task_4" name="Get 3 offers from logistic companies">
      <incoming>GEN_SequenceFlow_9</incoming>
      <outgoing>GEN_SequenceFlow_10</outgoing>
    </task>
    <task id="GEN_Task_5" name="Select logistic company and place order">
      <incoming>GEN_SequenceFlow_10</incoming>
      <outgoing>GEN_SequenceFlow_11</outgoing>
    </task>
    <task id="GEN_Task_6" name="Package goods">
      <incoming>GEN_SequenceFlow_17</incoming>
      <outgoing>GEN_SequenceFlow_14</outgoing>
    </task>
    <task id="GEN_Task_7" name="Prepare for picking up goods">
      <incoming>GEN_SequenceFlow_15</incoming>
      <outgoing>GEN_SequenceFlow_16</outgoing>
