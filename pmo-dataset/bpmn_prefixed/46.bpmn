    <sequenceFlow id="GEN_SequenceFlow_15" sourceRef="GEN_ExclusiveGateway_5" targetRef="GEN_ServiceTask_2"/>
    <sequenceFlow id="GEN_SequenceFlow_16" name="No" sourceRef="GEN_ExclusiveGateway_3" targetRef="GEN_ExclusiveGateway_5"/>
    <sequenceFlow id="GEN_SequenceFlow_17" name="No" sourceRef="GEN_ExclusiveGateway_2" targetRef="GEN_ExclusiveGateway_4"/>
    <sequenceFlow id="GEN_SequenceFlow_18" sourceRef="GEN_ParallelGateway_2" targetRef="GEN_ManualTask_5"/>
    <sequenceFlow id="GEN_SequenceFlow_19" sourceRef="GEN_ParallelGateway_1" targetRef="GEN_ManualTask_6"/>
    <sequenceFlow id="GEN_SequenceFlow_20" name="Yes" sourceRef="GEN_ExclusiveGateway_3" targetRef="GEN_ParallelGateway_1"/>
    <sequenceFlow id="GEN_SequenceFlow_21" sourceRef="GEN_ManualTask_4" targetRef="GEN_ParallelGateway_2"/>
