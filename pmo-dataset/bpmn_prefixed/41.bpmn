  <process id="GEN_Process_1">
    <userTask id="GEN_UserTask_1" name="Turn on bluetooth">
      <incoming>GEN_SequenceFlow_3</incoming>
      <outgoing>GEN_SequenceFlow_4</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_2" name="Enter type of Machine">
      <incoming>GEN_SequenceFlow_5</incoming>
      <outgoing>GEN_SequenceFlow_1</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_3" name="Enter serial number of machine">
      <incoming>GEN_SequenceFlow_1</incoming>
      <outgoing>GEN_SequenceFlow_2</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_4" name="Run 'Inspect-App'">
      <incoming>GEN_SequenceFlow_4</incoming>
      <incoming>GEN_SequenceFlow_18</incoming>
      <outgoing>GEN_SequenceFlow_5</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_5" name="Check the fill capacity">
      <incoming>GEN_SequenceFlow_7</incoming>
      <outgoing>GEN_SequenceFlow_8</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_6" name="Leave short Feedback">
      <incoming>GEN_SequenceFlow_19</incoming>
      <incoming>GEN_SequenceFlow_21</incoming>
      <outgoing>GEN_SequenceFlow_22</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_7" name="Press 'Produce' button">
      <incoming>GEN_SequenceFlow_9</incoming>
      <outgoing>GEN_SequenceFlow_10</outgoing>
    </userTask>
    <userTask id="GEN_UserTask_8" name="Press button 'Abort process'">
      <incoming>GEN_SequenceFlow_20</incoming>
      <incoming>GEN_SequenceFlow_22</incoming>
      <outgoing>GEN_SequenceFlow_11</outgoing>
    </userTask>
    <serviceTask id="GEN_ServiceTask_1" name="Connecting to device">
      <incoming>GEN_SequenceFlow_2</incoming>
      <outgoing>GEN_SequenceFlow_6</outgoing>
    </serviceTask>
    <serviceTask id="GEN_ServiceTask_2" name="Save Answers">
      <incoming>GEN_SequenceFlow_24</incoming>
      <outgoing>GEN_SequenceFlow_9</outgoing>
    </serviceTask>
    <serviceTask id="GEN_ServiceTask_3" name="Auto collect values">
      <incoming>GEN_SequenceFlow_12</incoming>
      <outgoing>GEN_SequenceFlow_15</outgoing>
    </serviceTask>
    <serviceTask id="GEN_ServiceTask_4" name="Show data">
      <incoming>GEN_SequenceFlow_13</incoming>
      <outgoing>GEN_SequenceFlow_14</outgoing>
    </serviceTask>
    <serviceTask id="GEN_ServiceTask_5" name="Present results">
      <incoming>GEN_SequenceFlow_16</incoming>
      <incoming>GEN_SequenceFlow_25</incoming>
      <outgoing>GEN_SequenceFlow_17</outgoing>
    </serviceTask>
    <exclusiveGateway id="GEN_ExclusiveGateway_1" name="Connected?">
      <incoming>GEN_SequenceFlow_6</incoming>
      <outgoing>GEN_SequenceFlow_7</outgoing>
      <outgoing>GEN_SequenceFlow_18</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_2" name="Is the fill level in the bootle ok?">
      <incoming>GEN_SequenceFlow_8</incoming>
      <outgoing>GEN_SequenceFlow_21</outgoing>
      <outgoing>GEN_SequenceFlow_23</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_3" name="Is the cap position straight?">
      <incoming>GEN_SequenceFlow_23</incoming>
      <outgoing>GEN_SequenceFlow_19</outgoing>
      <outgoing>GEN_SequenceFlow_24</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_4" name="Are the right bottles in the pack?">
      <incoming>GEN_SequenceFlow_10</incoming>
      <outgoing>GEN_SequenceFlow_20</outgoing>
      <outgoing>GEN_SequenceFlow_25</outgoing>
    </exclusiveGateway>
    <parallelGateway id="GEN_ParallelGateway_1">
      <incoming>GEN_SequenceFlow_11</incoming>
      <outgoing>GEN_SequenceFlow_12</outgoing>
      <outgoing>GEN_SequenceFlow_13</outgoing>
    </parallelGateway>
