{
    "startEvent": {
        "name": "Food order decided"
    },
    "process": [
        {
            "type": "task",
            "name": "Select type of order"
        },
        {
            "type": "xor",
            "condition": "Menu or just the burger ?",
            "branches": [
                {
                    "label": "With menu",
                    "branch": [
                        {
                            "type": "task",
                            "name": "Select menu"
                        },
                        {
                            "type": "task",
                            "name": "Select type of beverage"
                        },
                        {
                            "type": "parallel",
                            "branches": [
                                {
                                    "branch": [
                                        {
                                            "type": "task",
                                            "name": "Prepare beverage"
                                        }
                                    ]
                                },
                                {
                                    "branch": [
                                        {
                                            "type": "task",
                                            "name": "Select side"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "xor",
                            "condition": "Fries or wedges ?",
                            "branches": [
                                {
                                    "label": "Potato wedges",
                                    "branch": [
                                        {
                                            "type": "task",
                                            "name": "Prepare potato wedges"
                                        }
                                    ]
                                },
                                {
                                    "label": "French fries",
                                    "branch": [
                                        {
                                            "type": "task",
                                            "name": "Prepare French fries"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "label": "Burger only",
                    "branch": [
                        {
                            "type": "task",
                            "name": "Select burger"
                        }
                    ]
                }
            ]
        },
        {
            "type": "task",
            "name": "Make payment"
        },
        {
            "type": "task",
            "name": "Enter customer's name"
        },
        {
            "type": "parallel",
            "branches": [
                {
                    "branch": [
                        {
                            "type": "loop",
                            "condition": "No",
                            "body": [
                                {
                                    "type": "task",
                                    "name": "Update status"
                                },
                                {
                                    "type": "event",
                                    "name": "30 seconds"
                                },
                                {
                                    "type": "task",
                                    "name": "Check status"
                                }
                            ]
                        }
                    ]
                },
                {
                    "branch": [
                        {
                            "type": "task",
                            "name": "Prepare burger"
                        }
                    ]
                }
            ]
        },
        {
            "type": "task",
            "name": "Notify customer"
        },
        {
            "type": "task",
            "name": "Deliver via conveyor belt"
        }
    ],
    "endEvent": {
        "name": "Food delivered"
    }
}