<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" name="42" isExecutable="false">
    <task id="Task_1" name="Rate Service Facility">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </task>
    <task id="Task_2" name="Confirm that fridge is okay">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <task id="Task_3" name="Send a report to the fridge service center">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <task id="Task_4" name="Select local service facility">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <task id="Task_5" name="Schedule an appointment for fridge repair">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <task id="Task_6" name="Repair the fridge">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <task id="Task_7" name="Describe the symptoms">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <task id="Task_8" name="Collect fridge type data">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1" name="Submit a rating?">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="Additional parts needed?">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_18</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3" name="X">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1" name="+">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2" name="+">
      <incoming>SequenceFlow_13</incoming>
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </parallelGateway>
    <endEvent id="EndEvent_1" name="Repair process over">
      <incoming>SequenceFlow_1</incoming>
      <incoming>SequenceFlow_17</incoming>
    </endEvent>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Wait until service facility arrives">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </intermediateCatchEvent>
    <startEvent id="StartEvent_1" name="Fridge makes strange noises">
      <outgoing>SequenceFlow_16</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="Task_1" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_3" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_5" targetRef="IntermediateCatchEvent_1"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateCatchEvent_1" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_6" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_3" targetRef="Task_5"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_1" targetRef="Task_8"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_8" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_2" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_7" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="StartEvent_1" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3"/>
  </process>
</definitions>
