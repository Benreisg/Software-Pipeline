<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" name="45" isExecutable="false">
    <task id="Task_1" name="customer logs into E-Shop">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <task id="Task_2" name="customer credentials being checked by system">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <task id="Task_3" name="customer selects a product">
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <task id="Task_4" name="customer adds product to shopping cart">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <task id="Task_5" name="customer saves product">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <task id="Task_6" name="customer checks if product was already selected">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <task id="Task_7" name="Payment is prepared by system">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <task id="Task_8" name="Shipment is prepared by system">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <task id="Task_9" name="order is being finished by system">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </task>
    <task id="Task_10" name="customer enters payment data">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <task id="Task_11" name="customer enters shipping address">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <task id="Task_12" name="customer enters an independent billing adress">
      <incoming>SequenceFlow_20</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </task>
    <task id="Task_13" name="customer waits until bank confirms payment">
      <incoming>SequenceFlow_26</incoming>
      <outgoing>SequenceFlow_27</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1" name="succesful login?">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_25</outgoing>
      <outgoing>SequenceFlow_29</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="has customer selected all desired products?">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_21</outgoing>
      <outgoing>SequenceFlow_28</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1" name="+">
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2" name="+">
      <incoming>SequenceFlow_18</incoming>
      <incoming>SequenceFlow_27</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_3" name="+">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_26</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_4" name="+">
      <incoming>SequenceFlow_12</incoming>
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </parallelGateway>
    <exclusiveGateway id="ExclusiveGateway_3" name="if shipping adress == billing adress?">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_19</outgoing>
      <outgoing>SequenceFlow_20</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4" name="X">
      <incoming>SequenceFlow_17</incoming>
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_5" name="X">
      <incoming>SequenceFlow_22</incoming>
      <incoming>SequenceFlow_29</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_6" name="X">
      <incoming>SequenceFlow_25</incoming>
      <incoming>SequenceFlow_28</incoming>
      <outgoing>SequenceFlow_24</outgoing>
    </exclusiveGateway>
    <startEvent id="StartEvent_1" name="Open E-Shop Homepage">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Close E-Shop Homepage">
      <incoming>SequenceFlow_23</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_4" targetRef="Task_5"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_5" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_6" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="Task_8"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_2" targetRef="Task_9"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_10" targetRef="ParallelGateway_3"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_7" targetRef="ParallelGateway_4"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_8" targetRef="ParallelGateway_4"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_4" targetRef="Task_10"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ParallelGateway_3" targetRef="Task_11"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_11" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_12" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ExclusiveGateway_4" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_3" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_3" targetRef="Task_12"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="Task_9" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="ExclusiveGateway_5" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_24" sourceRef="ExclusiveGateway_6" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_25" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_26" sourceRef="ParallelGateway_3" targetRef="Task_13"/>
    <sequenceFlow id="SequenceFlow_27" sourceRef="Task_13" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_28" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_29" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_5"/>
  </process>
</definitions>
