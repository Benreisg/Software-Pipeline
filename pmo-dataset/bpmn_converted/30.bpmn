<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" name="30" isExecutable="false">
    <task id="Task_1" name="Send invites to 10 people">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <task id="Task_2" name="Ask which games do they want to play">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <task id="Task_3" name="Appoint a date">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <task id="Task_4" name="Reserve that day">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </task>
    <task id="Task_5" name="Ask friends how much beer they would like">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <task id="Task_6" name="Order beer for that date">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <task id="Task_7" name="Find where can you download the games">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <task id="Task_8" name="Download the missing games">
      <incoming>SequenceFlow_16</incoming>
      <incoming>SequenceFlow_20</incoming>
      <outgoing>SequenceFlow_26</outgoing>
    </task>
    <task id="Task_9" name="Send a notification that the LAN party will be held on that date">
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </task>
    <parallelGateway id="ParallelGateway_1" name="+">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </parallelGateway>
    <exclusiveGateway id="ExclusiveGateway_1" name="Do we have all the games?">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_25</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="How many people can play on that date?">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_2" name="+">
      <incoming>SequenceFlow_18</incoming>
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </parallelGateway>
    <exclusiveGateway id="ExclusiveGateway_3" name="Do you have enough beer?">
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_13</outgoing>
      <outgoing>SequenceFlow_23</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4" name="X">
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_23</incoming>
      <outgoing>SequenceFlow_21</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_5" name="Download successful?">
      <incoming>SequenceFlow_26</incoming>
      <outgoing>SequenceFlow_19</outgoing>
      <outgoing>SequenceFlow_20</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_6" name="X">
      <incoming>SequenceFlow_19</incoming>
      <incoming>SequenceFlow_25</incoming>
      <outgoing>SequenceFlow_24</outgoing>
    </exclusiveGateway>
    <startEvent id="StartEvent_1" name="Wish for a LAN gameparty">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Few hours, until the user has all the games that they want to play">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Few hours, until all people reply if they can play on that date">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="IntermediateCatchEvent_3" name="Few hours, until all people reply with t he amount of beer">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </intermediateCatchEvent>
    <endEvent id="EndEvent_1" name="LAN party done">
      <incoming>SequenceFlow_17</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="IntermediateCatchEvent_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateCatchEvent_1" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="IntermediateCatchEvent_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateCatchEvent_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_2" targetRef="Task_5"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="IntermediateCatchEvent_3"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_6" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_1" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_7" targetRef="Task_8"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_9" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="Task_4" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_5" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_5" targetRef="Task_8"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ExclusiveGateway_4" targetRef="Task_9"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="IntermediateCatchEvent_3" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="ExclusiveGateway_3" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_24" sourceRef="ExclusiveGateway_6" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_25" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_26" sourceRef="Task_8" targetRef="ExclusiveGateway_5"/>
  </process>
</definitions>
