  "Report Required?" -> "Report" [label="Yes"];
  "ExclusiveGateway_5" -> "ParallelGateway_1";
  "ExclusiveGateway_1" -> "ExclusiveGateway_4";
  "ExclusiveGateway_6" -> "Interview candidate";
  "ExclusiveGateway_2" -> "Is any job offer\nreceived?";
  "Is any job offer\nreceived?" -> "Submit job\napplication" [label="No"];
  "Is any job offer\nreceived?" -> "ExclusiveGateway_6" [label="Yes"];
  "Is one of the rating\nresults C or less?" -> "ExclusiveGateway_1" [label="Yes"];
  "Is candidate\nselected?" -> "ExclusiveGateway_4" [label="No"];
  "ParallelGateway_4" -> "Is one of the rating\nresults C or less?";
  "One year" -> "Publish applicant's\nreview";
  "Publish applicant's\nreview" -> "Job found";

  "Job needed" [shape=circle];
  "Job found" [shape=circle, penwidth=4];
  "One year" [shape=doublecircle];
  "Is job application\naccepted?_1" [label="Is job application\naccepted?", shape=diamond];
  "Is job application\naccepted?_2" [label="Is job application\naccepted?", shape=diamond];
  "Is candidate\nselected?" [shape=diamond];
  "Is one of the rating\nresults C or less?" [shape=diamond];
  "ExclusiveGateway_1" [label="X", shape=diamond];
  "ExclusiveGateway_2" [label="X", shape=diamond];
  "ExclusiveGateway_3" [label="X", shape=diamond];
  "ExclusiveGateway_4" [label="X", shape=diamond];
  "Report Required?" [shape=diamond];
  "ExclusiveGateway_5" [label="X", shape=diamond];
  "Is any job offer\nreceived?" [shape=diamond];
  "ExclusiveGateway_6" [label="X", shape=diamond];
