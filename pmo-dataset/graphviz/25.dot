  "Is job application\naccepted?_1" -> "Send autogenerated\nrejection Email" [label="No"];
  "ExclusiveGateway_3" -> "ExclusiveGateway_2";
  "Send rejection Email" -> "ExclusiveGateway_3";
  "ExclusiveGateway_4" -> "ExclusiveGateway_3";
