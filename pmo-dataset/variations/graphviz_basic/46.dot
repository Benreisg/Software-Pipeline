digraph G {
  rankdir=LR;  
  node [shape=box];

  "Storage management" -> "Read order";
  "Read order" -> "ExclusiveGateway_2";
  "Check if product is in stock" -> "Is in stock?";
  "Is in stock?" -> "Withdraw the Product from warehouse" [label="Yes"];
  "Is in stock?" -> "Reorder from wholesaler" [label="No"];
  "Reorder from wholesaler" -> "Waiting until arrives (handling system)";
  "Waiting until arrives (handling system)" -> "Arrived after more than ten days?";
  "Demand delivery delay penalty from the wholesaler" -> "ExclusiveGateway_1";
  "Arrived after more than ten days?" -> "Demand delivery delay penalty from the wholesaler" [label="Yes"];
  "Withdraw the Product from warehouse" -> "Check if the whole order is ready for shipment";
  "Register in stock management system" -> "Check if the whole order is ready for shipment";
  "Check if the whole order is ready for shipment" -> "Order is ready for shipment?";
  "Shipping the order" -> "Order was shipped";
  "ExclusiveGateway_1" -> "Register in stock management system";
  "ExclusiveGateway_2" -> "Check if product is in stock";
  "Order is ready for shipment?" -> "ExclusiveGateway_2" [label="No"];
  "Arrived after more than ten days?" -> "ExclusiveGateway_1" [label="No"];
  "ParallelGateway_2" -> "Shipping the order";
  "ParallelGateway_1" -> "Courier is requested";
  "Order is ready for shipment?" -> "ParallelGateway_1" [label="Yes"];
  "Packing the products" -> "ParallelGateway_2";
  "Courier is requested" -> "ParallelGateway_2";
  "ParallelGateway_1" -> "Packing the products";

  "Storage management" [shape=circle, label="Storage management"];
  "Order was shipped" [shape=circle, label="Order was shipped"];
  "Is in stock?" [shape=diamond];
  "Arrived after more than ten days?" [shape=diamond];
  "Order is ready for shipment?" [shape=diamond];
  "ExclusiveGateway_1" [shape=diamond, label="X"];
  "ExclusiveGateway_2" [shape=diamond, label="X"];
  "ParallelGateway_1" [shape=diamond, label="+"];
  "ParallelGateway_2" [shape=diamond, label="+"];
}