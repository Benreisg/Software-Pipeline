digraph G {
  rankdir=LR;  
  node [shape=box];

  "Enter type of Machine" -> "Enter serial number of machine";
  "Enter serial number of machine" -> "Connecting to device";
  "StartEvent" -> "Turn on bluetooth";
  "Turn on bluetooth" -> "Run 'Inspect-App'";
  "Run 'Inspect-App'" -> "Enter type of Machine";
  "Connecting to device" -> "Connected?";
  "Connected?" -> "Check the fill capacity" [label="yes"];
  "Check the fill capacity" -> "Is the fill level in the bootle ok?";
  "Save Answers" -> "Press 'Produce' button";
  "Press 'Produce' button" -> "Are the right bottles in the pack?";
  "Press button 'Abort process'" -> "ParallelGateway_1";
  "ParallelGateway_1" -> "Auto collect values";
  "ParallelGateway_1" -> "Show data";
  "Show data" -> "ParallelGateway_2";
  "Auto collect values" -> "ParallelGateway_2";
  "ParallelGateway_2" -> "Present results";
  "Present results" -> "EndEvent";
  "Connected?" -> "Run 'Inspect-App'" [label="no"];
  "Is the cap position straight?" -> "Leave short Feedback" [label="no"];
  "Are the right bottles in the pack?" -> "Press button 'Abort process'" [label="no"];
  "Is the fill level in the bootle ok?" -> "Leave short Feedback" [label="no"];
  "Leave short Feedback" -> "Press button 'Abort process'";
  "Is the fill level in the bootle ok?" -> "Is the cap position straight?" [label="yes"];
  "Is the cap position straight?" -> "Save Answers" [label="yes"];
  "Are the right bottles in the pack?" -> "Present results" [label="yes"];

  "StartEvent" [shape=circle, label=""];
  "EndEvent" [shape=circle, label=""];
  "Connected?" [shape=diamond];
  "Is the fill level in the bootle ok?" [shape=diamond];
  "Is the cap position straight?" [shape=diamond];
  "Are the right bottles in the pack?" [shape=diamond];
  "ParallelGateway_1" [shape=diamond, label="+"];
  "ParallelGateway_2" [shape=diamond, label="+"];
}