<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" name="">
    <task id="Task_1" name="Register for internship">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_24</outgoing>
    </task>
    <task id="Task_2" name="Enter topic">
      <incoming>SequenceFlow_26</incoming>
      <outgoing>SequenceFlow_28</outgoing>
    </task>
    <task id="Task_3" name="Enter expected income">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <task id="Task_4" name="Enter experience">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <task id="Task_5" name="Enter hobbies">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <task id="Task_6" name="Accept offer">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <task id="Task_7" name="Deny offer">
      <incoming>SequenceFlow_31</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <task id="Task_8" name="Publish your application">
      <incoming>SequenceFlow_30</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <task id="Task_9" name="Begin internship">
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <task id="Task_10" name="Write at least 3 status updates every week">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_20</outgoing>
    </task>
    <task id="Task_11" name="End internship">
      <incoming>SequenceFlow_25</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </task>
    <task id="Task_12" name="Recieve offer">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <task id="Task_13" name="Invalidate all other offers">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <task id="Task_14" name="Recommend company to a list of friends via twitter api">
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_35</outgoing>
    </task>
    <task id="Task_15" name="Recieve 3 status updates from the company">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </task>
    <startEvent id="StartEvent_1" name="Internship process is started">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Internship succesful">
      <incoming>SequenceFlow_34</incoming>
    </endEvent>
    <exclusiveGateway id="ExclusiveGateway_1" name="Accept offer?">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_31</outgoing>
      <outgoing>SequenceFlow_32</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_6</incoming>
