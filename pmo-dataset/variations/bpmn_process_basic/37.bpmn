<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" name="">
    <task id="Task_1" name="Query the next shop">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <task id="Task_2" name="Ask about quantity, price and deadline">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <task id="Task_3" name="Create a list of the parts">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <task id="Task_4" name="Reorder the cheapest part">
      <incoming>SequenceFlow_25</incoming>
      <outgoing>SequenceFlow_21</outgoing>
    </task>
    <task id="Task_5" name="Reorder the part as fast as possible">
      <incoming>SequenceFlow_26</incoming>
      <outgoing>SequenceFlow_20</outgoing>
    </task>
    <task id="Task_6" name="Receive first batch of parts">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <task id="Task_7" name="Receive second batch of parts">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <task id="Task_8" name="Receive third batch of parts">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <task id="Task_9" name="Start/Continue building">
      <incoming>SequenceFlow_17</incoming>
      <incoming>SequenceFlow_29</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </task>
    <task id="Task_10" name="Complain to the friends">
      <incoming>SequenceFlow_27</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </task>
    <startEvent id="StartEvent_1" name="Contract project received">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Project completed">
      <incoming>SequenceFlow_30</incoming>
    </endEvent>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="Terms acceptable?">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_3</incoming>
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4" name="More parts needed?">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_5" name="Any stock falls?">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_19</outgoing>
      <outgoing>SequenceFlow_24</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_6">
      <incoming>SequenceFlow_23</incoming>
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_28</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_7" name="How much is the stock fall?">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_25</outgoing>
      <outgoing>SequenceFlow_26</outgoing>
      <outgoing>SequenceFlow_27</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_8">
      <incoming>SequenceFlow_20</incoming>
      <incoming>SequenceFlow_21</incoming>
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_9" name="Contract fullfilled?">
      <incoming>SequenceFlow_28</incoming>
      <outgoing>SequenceFlow_29</outgoing>
      <outgoing>SequenceFlow_30</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </parallelGateway>
    <exclusiveGateway id="ExclusiveGateway_10" name="First parts arrived">
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_15</incoming>
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_3" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3" name="No"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_3" name="Yes"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_3" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_4" targetRef="ExclusiveGateway_1" name="Yes"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_4" targetRef="ParallelGateway_1" name="No"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_1" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_1" targetRef="Task_8"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_6" targetRef="ExclusiveGateway_10"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_7" targetRef="ExclusiveGateway_10"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_8" targetRef="ExclusiveGateway_10"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_10" targetRef="Task_9"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="Task_9" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_5" targetRef="ExclusiveGateway_7" name="Yes"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="Task_5" targetRef="ExclusiveGateway_8"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="Task_4" targetRef="ExclusiveGateway_8"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="Task_10" targetRef="ExclusiveGateway_8"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="ExclusiveGateway_8" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_24" sourceRef="ExclusiveGateway_5" targetRef="ExclusiveGateway_6" name="No"/>
    <sequenceFlow id="SequenceFlow_25" sourceRef="ExclusiveGateway_7" targetRef="Task_4" name="Below 5"/>
    <sequenceFlow id="SequenceFlow_26" sourceRef="ExclusiveGateway_7" targetRef="Task_5" name="Below 3"/>
    <sequenceFlow id="SequenceFlow_27" sourceRef="ExclusiveGateway_7" targetRef="Task_10" name="Zero"/>
    <sequenceFlow id="SequenceFlow_28" sourceRef="ExclusiveGateway_6" targetRef="ExclusiveGateway_9"/>
    <sequenceFlow id="SequenceFlow_29" sourceRef="ExclusiveGateway_9" targetRef="Task_9" name="No"/>
    <sequenceFlow id="SequenceFlow_30" sourceRef="ExclusiveGateway_9" targetRef="EndEvent_1" name="Yes"/>
  </process>
</definitions>
