<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" name="">
    <task id="Task_1" name="Determine properties">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <task id="Task_2" name="Check delivery of ordered parts">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <task id="Task_3" name="Perform Inspection">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <task id="Task_4" name="Send first saw">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <task id="Task_5" name="Cancel production of the remaining order">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <task id="Task_6" name="Send the remaining order">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </task>
    <task id="Task_7" name="Order parts">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <task id="Task_8" name="Order parts">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <task id="Task_9" name="Order parts">
      <incoming>SequenceFlow_20</incoming>
      <outgoing>SequenceFlow_21</outgoing>
    </task>
    <task id="Task_10" name="Assemble the parts">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <task id="Task_11" name="Send updates">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <task id="Task_12" name="Produce the remaining order">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </task>
    <startEvent id="StartEvent_1" name="Start">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="End">
      <incoming>SequenceFlow_16</incoming>
      <incoming>SequenceFlow_19</incoming>
    </endEvent>
    <exclusiveGateway id="ExclusiveGateway_1" name="Parts arrived ?">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="Customer Approval ?">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_20</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_8"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_7" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_8" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_2" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_2" name="No"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_1" targetRef="Task_3" name="Yes"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_3" targetRef="Task_10"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_10" targetRef="Task_11"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_11" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_2" targetRef="Task_5" name="No"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_5" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_2" targetRef="Task_12" name="Yes"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="Task_12" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="Task_6" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ParallelGateway_1" targetRef="Task_9"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="Task_9" targetRef="ParallelGateway_2"/>
  </process>
</definitions>
