<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" name="">
    <task id="Task_1" name="Develop basic design">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </task>
    <task id="Task_2" name="Order Lego brick sets">
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <task id="Task_3" name="Test subcomponent 1">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <task id="Task_4" name="Test subcomponent 2">
      <incoming>SequenceFlow_28</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </task>
    <task id="Task_5" name="Test subcomponent 3">
      <incoming>SequenceFlow_29</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <task id="Task_6" name="Test subcomponent 4">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <task id="Task_7" name="Give the lego sets to the children">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <task id="Task_8" name="Sort the parts into containers">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_25</outgoing>
    </task>
    <task id="Task_9" name="Build the next subcomponent">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <task id="Task_10" name="Reorder parts">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <task id="Task_11" name="Assemble subcomponents">
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </task>
    <startEvent id="StartEvent_1" name="New order received">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Machine assembled">
      <incoming>SequenceFlow_17</incoming>
    </endEvent>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_26</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="Parts remained?">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_22</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3" name="Container empty?">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_9</incoming>
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_5" name="All tests successfull?">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_20</outgoing>
      <outgoing>SequenceFlow_21</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_6">
      <incoming>SequenceFlow_1</incoming>
      <incoming>SequenceFlow_20</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_7" name="Brick sets already ordered?">
      <incoming>SequenceFlow_23</incoming>
      <outgoing>SequenceFlow_24</outgoing>
      <outgoing>SequenceFlow_27</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_8">
      <incoming>SequenceFlow_25</incoming>
      <incoming>SequenceFlow_27</incoming>
      <outgoing>SequenceFlow_26</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_28</outgoing>
      <outgoing>SequenceFlow_29</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_13</incoming>
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_15</incoming>
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_6"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_2" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_7" targetRef="Task_8"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_1" name="Yes"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_4" targetRef="Task_9"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_9" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_3" targetRef="Task_10" name="Yes"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_10" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="ExclusiveGateway_4" name="No"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_5" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_3" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ParallelGateway_2" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_11" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="Task_4" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_6" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_5" targetRef="ExclusiveGateway_6" name="No"/>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ExclusiveGateway_5" targetRef="Task_11" name="Yes"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1" name="No"/>
    <sequenceFlow id="SequenceFlow_23" sourceRef="Task_1" targetRef="ExclusiveGateway_7"/>
    <sequenceFlow id="SequenceFlow_24" sourceRef="ExclusiveGateway_7" targetRef="Task_2" name="No"/>
    <sequenceFlow id="SequenceFlow_25" sourceRef="Task_8" targetRef="ExclusiveGateway_8"/>
    <sequenceFlow id="SequenceFlow_26" sourceRef="ExclusiveGateway_8" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_27" sourceRef="ExclusiveGateway_7" targetRef="ExclusiveGateway_8" name="Yes"/>
    <sequenceFlow id="SequenceFlow_28" sourceRef="ParallelGateway_1" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_29" sourceRef="ParallelGateway_1" targetRef="Task_5"/>
  </process>
