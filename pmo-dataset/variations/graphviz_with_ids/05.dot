digraph G {
  rankdir=LR;  
  node [shape=box];

  "Task_1" [label="Sign contract"];
  "Task_2" [label="Conduct site visit"];
  "Task_3" [label="Execute contract"];
  "Task_4" [label="Identify need for\nnew supplier or\nvendor"];
