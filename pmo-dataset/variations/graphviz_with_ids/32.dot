  "ParallelGateway_3" [shape=diamond, label="+"];
  "ParallelGateway_4" [shape=diamond, label="+"];
  "InclusiveGateway_1" [shape=diamond, label="O"];
  "InclusiveGateway_2" [shape=diamond, label="O"];

  "StartNoneEvent_1" -> "User_1";
  "ExclusiveGateway_3" -> "Service_2" [label="Yes"];
  "User_4" -> "InclusiveGateway_2";
  "User_3" -> "InclusiveGateway_2";
  "ParallelGateway_1" -> "Task_3";
  "Task_3" -> "ParallelGateway_2";
  "ParallelGateway_2" -> "ExclusiveGateway_1";
  "Task_4" -> "ExclusiveGateway_2";
