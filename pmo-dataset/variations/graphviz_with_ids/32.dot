  "ExclusiveGateway_2" -> "Task_2";
  "ExclusiveGateway_1" -> "ExclusiveGateway_2" [label="No"];
  "User_2" -> "ExclusiveGateway_4";
  "ExclusiveGateway_4" -> "ExclusiveGateway_5";
  "Service_1" -> "Task_6";
  "Task_5" -> "ExclusiveGateway_6";
  "User_1" -> "ParallelGateway_1";
  "Service_2" -> "User_2";
  "ExclusiveGateway_6" -> "ExclusiveGateway_3";
  "Task_6" -> "ExclusiveGateway_6";
  "Task_8" -> "ExclusiveGateway_7";
