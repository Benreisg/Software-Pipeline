  "Task_1" -> "ExclusiveGateway_4";
  "ExclusiveGateway_4" -> "Task_4";
  "ExclusiveGateway_1" -> "EndNoneEvent_1";
  "ExclusiveGateway_4" -> "ExclusiveGateway_1";
  "ExclusiveGateway_2" -> "Task_2";
  "Task_8" -> "ExclusiveGateway_3";
  "Task_5" -> "Task_6";
  "Task_9" -> "ExclusiveGateway_2";
  "Task_4" -> "ExclusiveGateway_1";
  "Task_7" -> "Task_5";
  "ExclusiveGateway_2" -> "Task_8";
