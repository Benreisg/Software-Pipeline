  "ParallelGateway_2" [shape=diamond, label="+"];
  "ParallelGateway_3" [shape=diamond, label="+"];
  "ParallelGateway_4" [shape=diamond, label="+"];

  "Manual_3" -> "ParallelGateway_2";
  "Manual_2" -> "ParallelGateway_2";
  "ParallelGateway_2" -> "Service_1";
  "Manual_5" -> "Manual_6";
  "Manual_6" -> "ExclusiveGateway_1";
  "ExclusiveGateway_1" -> "EndNoneEvent_1";
  "StartNoneEvent_1" -> "ParallelGateway_3";
  "ParallelGateway_3" -> "Service_3";
  "ParallelGateway_3" -> "Service_2";
  "Service_3" -> "ParallelGateway_4";
  "Service_2" -> "ParallelGateway_4";
  "ParallelGateway_4" -> "Manual_1";
  "ExclusiveGateway_2" -> "Manual_7";
  "Manual_7" -> "ExclusiveGateway_3";
  "Manual_8" -> "ExclusiveGateway_2";
  "ExclusiveGateway_2" -> "ExclusiveGateway_3";
  "Service_1" -> "Service_4";
