  "Service_8" [label="Notify customer"];
  "StartNoneEvent_1" [shape=circle, label="Food order decided"];
  "EndNoneEvent_1" [shape=circle, penwidth=4, label="Food delivered"];
  "IntermediateTimerEvent_1" [shape=doublecircle, label="30 seconds"];
  "ExclusiveGateway_1" [shape=diamond, label="Menu or just the\nburger ?"];
  "ExclusiveGateway_2" [shape=diamond, label="Fries or wedges ?"];
