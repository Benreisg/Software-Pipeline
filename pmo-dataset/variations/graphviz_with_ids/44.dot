  "ExclusiveGateway_4" [shape=diamond, label="X"];
  "ExclusiveGateway_5" [shape=diamond, label="X"];
  "ExclusiveGateway_6" [shape=diamond, label="Is burger ready ?"];
  "ParallelGateway_1" [shape=diamond, label="+"];
  "ParallelGateway_2" [shape=diamond, label="+"];
  "ParallelGateway_3" [shape=diamond, label="+"];
  "ParallelGateway_4" [shape=diamond, label="+"];

  "StartNoneEvent_1" -> "User_1";
  "User_1" -> "ExclusiveGateway_1";
  "User_3" -> "ParallelGateway_1";
  "ParallelGateway_1" -> "Service_1";
  "ParallelGateway_1" -> "User_4";
  "Service_1" -> "ParallelGateway_2";
  "User_4" -> "ParallelGateway_2";
  "Service_2" -> "ExclusiveGateway_3";
  "Service_3" -> "ExclusiveGateway_3";
  "ExclusiveGateway_2" -> "Service_2" [label="Potato wedges"];
  "ExclusiveGateway_2" -> "Service_3" [label="French fries"];
  "ParallelGateway_2" -> "ExclusiveGateway_2";
  "User_5" -> "User_3";
  "User_2" -> "ExclusiveGateway_4";
  "ExclusiveGateway_1" -> "User_5" [label="With menu"];
  "ExclusiveGateway_3" -> "ExclusiveGateway_4";
  "ParallelGateway_3" -> "ExclusiveGateway_5";
  "IntermediateTimerEvent_1" -> "Service_5";
  "Service_5" -> "ExclusiveGateway_6";
  "Service_4" -> "ParallelGateway_4";
  "Service_7" -> "EndNoneEvent_1";
  "ExclusiveGateway_5" -> "Service_6";
  "Service_6" -> "IntermediateTimerEvent_1";
  "ParallelGateway_4" -> "Service_8";
  "Service_8" -> "Service_7";
  "ExclusiveGateway_1" -> "User_2" [label="Burger only"];
  "ExclusiveGateway_6" -> "ExclusiveGateway_5" [label="No"];
