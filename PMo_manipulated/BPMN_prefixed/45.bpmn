  <process id="GEN_Process_1">
    <task id="GEN_Task_1" name="customer waits until bank confirms payment">
      <incoming>GEN_SequenceFlow_26</incoming>
      <outgoing>GEN_SequenceFlow_27</outgoing>
    </task>
    <serviceTask id="GEN_ServiceTask_1" name="customer credentials being checked by system">
      <incoming>GEN_SequenceFlow_2</incoming>
      <outgoing>GEN_SequenceFlow_3</outgoing>
    </serviceTask>
    <serviceTask id="GEN_ServiceTask_2" name="Payment is prepared by system">
      <incoming>GEN_SequenceFlow_8</incoming>
      <outgoing>GEN_SequenceFlow_12</outgoing>
    </serviceTask>
    <serviceTask id="GEN_ServiceTask_3" name="Shipment is prepared by system">
      <incoming>GEN_SequenceFlow_9</incoming>
      <outgoing>GEN_SequenceFlow_13</outgoing>
    </serviceTask>
    <serviceTask id="GEN_ServiceTask_4" name="order is being finished by system">
      <incoming>GEN_SequenceFlow_10</incoming>
      <outgoing>GEN_SequenceFlow_22</outgoing>
    </serviceTask>
    <manualTask id="GEN_ManualTask_1" name="customer logs into E-Shop">
      <incoming>GEN_SequenceFlow_1</incoming>
      <outgoing>GEN_SequenceFlow_2</outgoing>
    </manualTask>
    <manualTask id="GEN_ManualTask_2" name="customer selects a product">
      <incoming>GEN_SequenceFlow_24</incoming>
      <outgoing>GEN_SequenceFlow_4</outgoing>
      <outgoing>GEN_SequenceFlow_30</outgoing>
    </manualTask>
    <manualTask id="GEN_ManualTask_3" name="customer adds product to shopping cart">
      <incoming>GEN_SequenceFlow_4</incoming>
      <outgoing>GEN_SequenceFlow_5</outgoing>
    </manualTask>
    <manualTask id="GEN_ManualTask_4" name="customer saves product">
      <incoming>GEN_SequenceFlow_5</incoming>
      <outgoing>GEN_SequenceFlow_6</outgoing>
    </manualTask>
    <manualTask id="GEN_ManualTask_5" name="customer checks if product was already selected">
      <incoming>GEN_SequenceFlow_6</incoming>
      <outgoing>GEN_SequenceFlow_7</outgoing>
      <incoming>GEN_SequenceFlow_30</incoming>
    </manualTask>
    <manualTask id="GEN_ManualTask_6" name="customer enters payment data">
      <incoming>GEN_SequenceFlow_14</incoming>
      <outgoing>GEN_SequenceFlow_11</outgoing>
    </manualTask>
    <manualTask id="GEN_ManualTask_7" name="customer enters shipping address">
      <incoming>GEN_SequenceFlow_15</incoming>
      <outgoing>GEN_SequenceFlow_16</outgoing>
    </manualTask>
    <manualTask id="GEN_ManualTask_8" name="customer enters an independent billing adress">
      <incoming>GEN_SequenceFlow_20</incoming>
      <outgoing>GEN_SequenceFlow_17</outgoing>
    </manualTask>
    <exclusiveGateway id="GEN_ExclusiveGateway_1" name="succesful login?">
      <incoming>GEN_SequenceFlow_3</incoming>
      <outgoing>GEN_SequenceFlow_25</outgoing>
      <outgoing>GEN_SequenceFlow_29</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_2" name="has customer chosen all desired products?">
      <incoming>GEN_SequenceFlow_7</incoming>
      <outgoing>GEN_SequenceFlow_21</outgoing>
      <outgoing>GEN_SequenceFlow_28</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_3" name="if delivery adress == billing adress?">
      <incoming>GEN_SequenceFlow_16</incoming>
      <outgoing>GEN_SequenceFlow_19</outgoing>
      <outgoing>GEN_SequenceFlow_20</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_4">
      <incoming>GEN_SequenceFlow_17</incoming>
      <incoming>GEN_SequenceFlow_19</incoming>
      <outgoing>GEN_SequenceFlow_18</outgoing>
