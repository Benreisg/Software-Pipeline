  <collaboration id="GEN_Collaboration_1">
    <participant id="GEN_Participant_1" name="Recourse Clerk" processRef="GEN_Process_1"/>
  </collaboration>
  <process id="GEN_Process_1">
    <task id="GEN_Task_1" name="check case">
      <incoming>GEN_SequenceFlow_1</incoming>
      <outgoing>GEN_SequenceFlow_2</outgoing>
    </task>
    <task id="GEN_Task_2" name="send request for payment">
      <incoming>GEN_SequenceFlow_3</incoming>
      <outgoing>GEN_SequenceFlow_6</outgoing>
    </task>
    <task id="GEN_Task_3" name="close case">
      <incoming>GEN_SequenceFlow_4</incoming>
      <outgoing>GEN_SequenceFlow_5</outgoing>
    </task>
    <task id="GEN_Task_4" name="send reminder">
      <incoming>GEN_SequenceFlow_6</incoming>
      <outgoing>GEN_SequenceFlow_7</outgoing>
    </task>
    <task id="GEN_Task_5" name="check reasoning">
      <incoming>GEN_SequenceFlow_9</incoming>
      <outgoing>GEN_SequenceFlow_10</outgoing>
    </task>
    <task id="GEN_Task_6" name="close case">
      <incoming>GEN_SequenceFlow_11</incoming>
      <outgoing>GEN_SequenceFlow_12</outgoing>
    </task>
    <task id="GEN_Task_7" name="hand over to collection agency">
      <incoming>GEN_SequenceFlow_14</incoming>
      <incoming>GEN_SequenceFlow_15</incoming>
      <outgoing>GEN_SequenceFlow_16</outgoing>
    </task>
    <task id="GEN_Task_8" name="make booking">
      <incoming>GEN_SequenceFlow_18</incoming>
      <outgoing>GEN_SequenceFlow_19</outgoing>
    </task>
    <task id="GEN_Task_9" name="close case">
      <incoming>GEN_SequenceFlow_19</incoming>
      <outgoing>GEN_SequenceFlow_20</outgoing>
    </task>
    <exclusiveGateway id="GEN_ExclusiveGateway_1" name="recourse feasible?">
      <incoming>GEN_SequenceFlow_2</incoming>
      <outgoing>GEN_SequenceFlow_3</outgoing>
      <outgoing>GEN_SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_2" name="Acceptable?">
      <incoming>GEN_SequenceFlow_10</incoming>
      <outgoing>GEN_SequenceFlow_11</outgoing>
      <outgoing>GEN_SequenceFlow_15</outgoing>
    </exclusiveGateway>
    <eventBasedGateway id="GEN_EventBasedGateway_1">
      <incoming>GEN_SequenceFlow_7</incoming>
      <outgoing>GEN_SequenceFlow_8</outgoing>
      <outgoing>GEN_SequenceFlow_13</outgoing>
      <outgoing>GEN_SequenceFlow_17</outgoing>
    </eventBasedGateway>
    <startEvent id="GEN_StartEvent_1" name="probable recourse detected">
      <messageEventDefinition/>
      <outgoing>GEN_SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="GEN_EndEvent_1" name="case closed">
      <incoming>GEN_SequenceFlow_5</incoming>
    </endEvent>
    <endEvent id="GEN_EndEvent_2" name="case closed">
      <incoming>GEN_SequenceFlow_12</incoming>
    </endEvent>
    <endEvent id="GEN_EndEvent_3" name="case open">
      <incoming>GEN_SequenceFlow_16</incoming>
    </endEvent>
    <endEvent id="GEN_EndEvent_4" name="case closed">
      <incoming>GEN_SequenceFlow_20</incoming>
    </endEvent>
    <intermediateCatchEvent id="GEN_IntermediateCatchEvent_1" name="disagreement letter received">
      <messageEventDefinition/>
      <incoming>GEN_SequenceFlow_8</incoming>
      <outgoing>GEN_SequenceFlow_9</outgoing>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="GEN_IntermediateCatchEvent_2" name="Reminder is due">
      <timerEventDefinition/>
      <incoming>GEN_SequenceFlow_13</incoming>
      <outgoing>GEN_SequenceFlow_14</outgoing>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="GEN_IntermediateCatchEvent_3" name="Money received">
      <messageEventDefinition/>
      <incoming>GEN_SequenceFlow_17</incoming>
      <outgoing>GEN_SequenceFlow_18</outgoing>
    </intermediateCatchEvent>
