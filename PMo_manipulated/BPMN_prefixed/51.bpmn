<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="GEN_Process_1">
    <task id="GEN_Task_1" name="Employee submits a vacation request">
      <incoming>GEN_SequenceFlow_1</incoming>
      <outgoing>GEN_SequenceFlow_2</outgoing>
      <outgoing>GEN_SequenceFlow_13</outgoing>
    </task>
    <task id="GEN_Task_2" name="Specification is registered">
      <incoming>GEN_SequenceFlow_2</incoming>
      <outgoing>GEN_SequenceFlow_3</outgoing>
    </task>
    <task id="GEN_Task_3" name="Employee's supervisor receive the request">
      <incoming>GEN_SequenceFlow_3</incoming>
      <outgoing>GEN_SequenceFlow_4</outgoing>
      <incoming>GEN_SequenceFlow_13</incoming>
    </task>
    <task id="GEN_Task_4" name="Supervisor approve or reject the request">
      <incoming>GEN_SequenceFlow_4</incoming>
      <outgoing>GEN_SequenceFlow_5</outgoing>
    </task>
    <task id="GEN_Task_5" name="Application is returned to employee">
      <incoming>GEN_SequenceFlow_9</incoming>
      <outgoing>GEN_SequenceFlow_11</outgoing>
    </task>
    <task id="GEN_Task_6" name="Alert is generated to the HR Representative">
      <incoming>GEN_SequenceFlow_10</incoming>
      <outgoing>GEN_SequenceFlow_6</outgoing>
    </task>
    <task id="GEN_Task_7" name="HR Representative complete the respective management procedures">
      <incoming>GEN_SequenceFlow_6</incoming>
      <outgoing>GEN_SequenceFlow_7</outgoing>
    </task>
    <task id="GEN_Task_8" name="Employee can check rejection reasons">
      <incoming>GEN_SequenceFlow_11</incoming>
      <outgoing>GEN_SequenceFlow_12</outgoing>
    </task>
    <exclusiveGateway id="GEN_ExclusiveGateway_1">
      <incoming>GEN_SequenceFlow_5</incoming>
      <outgoing>GEN_SequenceFlow_9</outgoing>
      <outgoing>GEN_SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_2">
      <incoming>GEN_SequenceFlow_7</incoming>
      <incoming>GEN_SequenceFlow_12</incoming>
      <outgoing>GEN_SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <startEvent id="GEN_StartEvent_1">
      <outgoing>GEN_SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="GEN_EndEvent_1">
      <incoming>GEN_SequenceFlow_8</incoming>
    </endEvent>
    <sequenceFlow id="GEN_SequenceFlow_1" sourceRef="GEN_StartEvent_1" targetRef="GEN_Task_1"/>
    <sequenceFlow id="GEN_SequenceFlow_2" sourceRef="GEN_Task_1" targetRef="GEN_Task_2"/>
    <sequenceFlow id="GEN_SequenceFlow_3" sourceRef="GEN_Task_2" targetRef="GEN_Task_3"/>
    <sequenceFlow id="GEN_SequenceFlow_4" sourceRef="GEN_Task_3" targetRef="GEN_Task_4"/>
    <sequenceFlow id="GEN_SequenceFlow_5" sourceRef="GEN_Task_4" targetRef="GEN_ExclusiveGateway_1"/>
    <sequenceFlow id="GEN_SequenceFlow_6" sourceRef="GEN_Task_6" targetRef="GEN_Task_7"/>
    <sequenceFlow id="GEN_SequenceFlow_7" sourceRef="GEN_Task_7" targetRef="GEN_ExclusiveGateway_2"/>
    <sequenceFlow id="GEN_SequenceFlow_8" sourceRef="GEN_ExclusiveGateway_2" targetRef="GEN_EndEvent_1"/>
    <sequenceFlow id="GEN_SequenceFlow_9" name="rejected" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_Task_5"/>
    <sequenceFlow id="GEN_SequenceFlow_10" name="approved" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_Task_6"/>
    <sequenceFlow id="GEN_SequenceFlow_11" sourceRef="GEN_Task_5" targetRef="GEN_Task_8"/>
    <sequenceFlow id="GEN_SequenceFlow_12" sourceRef="GEN_Task_8" targetRef="GEN_ExclusiveGateway_2"/>
    <sequenceFlow id="GEN_SequenceFlow_13" sourceRef="GEN_Task_1" targetRef="GEN_Task_3"/>
  </process>
