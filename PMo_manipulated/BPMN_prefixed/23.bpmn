    <sequenceFlow id="GEN_SequenceFlow_6" name="yes" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_ExclusiveGateway_2"/>
    <sequenceFlow id="GEN_SequenceFlow_7" sourceRef="GEN_ExclusiveGateway_2" targetRef="GEN_Task_2"/>
    <sequenceFlow id="GEN_SequenceFlow_8" sourceRef="GEN_Task_2" targetRef="GEN_EndEvent_1"/>
  </process>
