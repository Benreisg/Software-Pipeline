      <outgoing>GEN_SequenceFlow_3</outgoing>
      <outgoing>GEN_SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_2">
      <incoming>GEN_SequenceFlow_6</incoming>
      <outgoing>GEN_SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <startEvent id="GEN_StartEvent_1" name="scoring request received">
      <messageEventDefinition/>
      <outgoing>GEN_SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="GEN_EndEvent_1" name="scoring request handled">
      <incoming>GEN_SequenceFlow_8</incoming>
    </endEvent>
    <intermediateCatchEvent id="GEN_IntermediateCatchEvent_1" name="credit score received">
      <messageEventDefinition/>
      <incoming>GEN_SequenceFlow_4</incoming>
    </intermediateCatchEvent>
    <sequenceFlow id="GEN_SequenceFlow_1" sourceRef="GEN_StartEvent_1" targetRef="GEN_Task_1"/>
