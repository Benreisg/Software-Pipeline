<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="GEN_Process_1">
    <task id="GEN_Task_1" name="Claim is registered">
      <incoming>GEN_SequenceFlow_1</incoming>
      <outgoing>GEN_SequenceFlow_2</outgoing>
    </task>
    <task id="GEN_Task_2" name="Claim is examined by a claims officer">
      <incoming>GEN_SequenceFlow_2</incoming>
      <outgoing>GEN_SequenceFlow_6</outgoing>
    </task>
    <task id="GEN_Task_3" name="Claims officer writes a settlement recommendation">
      <incoming>GEN_SequenceFlow_7</incoming>
      <outgoing>GEN_SequenceFlow_3</outgoing>
    </task>
    <task id="GEN_Task_4" name="Recommendation is checked by a senior claims officer">
      <incoming>GEN_SequenceFlow_3</incoming>
      <outgoing>GEN_SequenceFlow_4</outgoing>
    </task>
    <task id="GEN_Task_5" name="Senior claims officer marks the claim">
      <incoming>GEN_SequenceFlow_4</incoming>
      <outgoing>GEN_SequenceFlow_5</outgoing>
      <incoming>GEN_SequenceFlow_12</incoming>
    </task>
    <task id="GEN_Task_6" name="Claim is sent back">
      <incoming>GEN_SequenceFlow_10</incoming>
    </task>
    <task id="GEN_Task_7" name="Claim handling process proceeds">
      <incoming>GEN_SequenceFlow_9</incoming>
      <outgoing>GEN_SequenceFlow_11</outgoing>
    </task>
    <exclusiveGateway id="GEN_ExclusiveGateway_1">
      <incoming>GEN_SequenceFlow_5</incoming>
      <outgoing>GEN_SequenceFlow_9</outgoing>
      <outgoing>GEN_SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GEN_ExclusiveGateway_2">
      <incoming>GEN_SequenceFlow_6</incoming>
      <outgoing>GEN_SequenceFlow_7</outgoing>
      <outgoing>GEN_SequenceFlow_12</outgoing>
    </exclusiveGateway>
    <startEvent id="GEN_StartEvent_1">
      <outgoing>GEN_SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="GEN_EndEvent_1">
      <incoming>GEN_SequenceFlow_11</incoming>
    </endEvent>
    <sequenceFlow id="GEN_SequenceFlow_1" sourceRef="GEN_StartEvent_1" targetRef="GEN_Task_1"/>
    <sequenceFlow id="GEN_SequenceFlow_2" sourceRef="GEN_Task_1" targetRef="GEN_Task_2"/>
    <sequenceFlow id="GEN_SequenceFlow_3" sourceRef="GEN_Task_3" targetRef="GEN_Task_4"/>
    <sequenceFlow id="GEN_SequenceFlow_4" sourceRef="GEN_Task_4" targetRef="GEN_Task_5"/>
    <sequenceFlow id="GEN_SequenceFlow_5" sourceRef="GEN_Task_5" targetRef="GEN_ExclusiveGateway_1"/>
    <sequenceFlow id="GEN_SequenceFlow_6" sourceRef="GEN_Task_2" targetRef="GEN_ExclusiveGateway_2"/>
    <sequenceFlow id="GEN_SequenceFlow_7" sourceRef="GEN_ExclusiveGateway_2" targetRef="GEN_Task_3"/>
    <sequenceFlow id="GEN_SequenceFlow_9" name="OK" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_Task_7"/>
    <sequenceFlow id="GEN_SequenceFlow_10" name="Not OK" sourceRef="GEN_ExclusiveGateway_1" targetRef="GEN_Task_6"/>
    <sequenceFlow id="GEN_SequenceFlow_11" sourceRef="GEN_Task_7" targetRef="GEN_EndEvent_1"/>
    <sequenceFlow id="GEN_SequenceFlow_12" sourceRef="GEN_ExclusiveGateway_2" targetRef="GEN_Task_5"/>
  </process>
