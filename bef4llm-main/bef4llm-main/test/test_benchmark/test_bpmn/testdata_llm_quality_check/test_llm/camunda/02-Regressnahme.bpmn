<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Meldung über möglichen Regress">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:task id="Task_1" name="Prüfung des Falls">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Regress möglich?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="EndEvent_1"/>
    <bpmn:task id="Task_2" name="Zahlungsaufforderung an VN">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    <bpmn:endEvent id="EndEvent_1" name="Vorgang schließen">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="Task_3"/>
    <bpmn:task id="Task_3" name="Wiedervorlage setzen">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="ParallelGateway_1"/>
    <bpmn:parallelGateway id="ParallelGateway_1">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="Task_4"/>
    <bpmn:task id="Task_4" name="Geldeingang verbuchen">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="Task_5"/>
    <bpmn:task id="Task_5" name="Widerspruch prüfen">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Zahlungsverweigerung gerechtfertigt?">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="Task_6"/>
    <bpmn:task id="Task_6" name="Abgabe an Inkasso-Dienstleister">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_6" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>