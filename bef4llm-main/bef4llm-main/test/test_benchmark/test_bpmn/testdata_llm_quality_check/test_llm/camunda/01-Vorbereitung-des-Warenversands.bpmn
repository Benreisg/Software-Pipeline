<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0">
    <bpmn:participant id="Participant_Sekretariat" name="Sekretariat" processRef="Process_1"/>
    <bpmn:participant id="Participant_Logistikleiter" name="Logistikleiter" processRef="Process_1"/>
    <bpmn:participant id="Participant_Lagerarbeiter" name="Lagerarbeiter" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sekretariat" name="Sekretariat">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoltAngebote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaehltAngebot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BeauftragtSpediteur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FuelltPaketschein</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistikleiter" name="Logistikleiter">
        <bpmn:flowNodeRef>Task_AbschliesstVersicherung</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lagerarbeiter" name="Lagerarbeiter">
        <bpmn:flowNodeRef>Task_VerpaktWare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BereitstelltWare</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Versand starten">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Große Menge?">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Ja" sourceRef="ExclusiveGateway_1" targetRef="Task_HoltAngebote"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" name="Nein" sourceRef="ExclusiveGateway_1" targetRef="Task_FuelltPaketschein"/>
    <bpmn:task id="Task_HoltAngebote" name="Holt Angebote von Spediteuren">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_HoltAngebote" targetRef="Task_WaehltAngebot"/>
    <bpmn:task id="Task_WaehltAngebot" name="Wählt Angebot aus">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_WaehltAngebot" targetRef="Task_BeauftragtSpediteur"/>
    <bpmn:task id="Task_BeauftragtSpediteur" name="Beauftragt Spediteur">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_BeauftragtSpediteur" targetRef="Task_VerpaktWare"/>
    <bpmn:task id="Task_FuelltPaketschein" name="Füllt Paketschein aus">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_FuelltPaketschein" targetRef="Task_AbschliesstVersicherung"/>
    <bpmn:task id="Task_AbschliesstVersicherung" name="Abschließt Versicherung">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_AbschliesstVersicherung" targetRef="Task_VerpaktWare"/>
    <bpmn:task id="Task_VerpaktWare" name="Verpackt Ware">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_VerpaktWare" targetRef="Task_BereitstelltWare"/>
    <bpmn:task id="Task_BereitstelltWare" name="Bereitstellt Ware zur Abholung">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Versand abgeschlossen">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_BereitstelltWare" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>