    <bpmn:userTask id="UserTask_0i80x50" name="Bankverbindung manuell prüfen" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${ErstelleAufgabeListener}" event="create" />
        <camunda:inputOutput>
          <camunda:inputParameter name="Variablenfilter" bm:type="Property">A005FSEPAFachdatenPruefen</camunda:inputParameter>
          <camunda:inputParameter name="FehlerVariablenfilter" bm:type="Property">false</camunda:inputParameter>
          <camunda:inputParameter name="AufgabendefinitionName" bm:type="K">Aktionssteuerung Prozessinstanzdaten bearbeiten</camunda:inputParameter>
          <camunda:inputParameter name="Partner" bm:type="PV">${intPartnerID}</camunda:inputParameter>
          <camunda:inputParameter name="Status" bm:type="K">IDLE</camunda:inputParameter>
          <camunda:inputParameter name="ErfasstVon" bm:type="K">Prozess A_005</camunda:inputParameter>
          <camunda:inputParameter name="Bemerkung" bm:type="K">Bitte passen Sie die Prozesseingangsdaten an und verarbeiten diese erneut im Prozess. Ist eine maschinelle Verarbeitung nicht möglich stoppen Sie bitte die maschinelle Verarbeitung und bearbeiten den Fall vollständig manuell.</camunda:inputParameter>
          <camunda:inputParameter name="Vorgangsnotiz" bm:type="K">Die Bankverbindung konnte nicht angelegt werden.</camunda:inputParameter>
          <camunda:inputParameter name="Wiedervorlagedatum" bm:type="SV">${now()}</camunda:inputParameter>
          <camunda:inputParameter name="ErfasstAm" bm:type="SV">${now()}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_0ghnaet</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_064rvod</bpmn:outgoing>
