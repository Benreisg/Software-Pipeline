    <bpmn:textAnnotation id="TextAnnotation_1fne924">
      <bpmn:text>Fälligkeit zum 1. eines Monats (auch We oder FT) Ergänzung der Aufgabe mit Anzahl Exemplare: 1-99 und Intervall (Wiedervorlage): 1=monatlich und 3=quartalsweise</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1h2os0e" sourceRef="StartEvent_1" targetRef="TextAnnotation_1fne924" />
    <bpmn:association id="Association_1l7a219" sourceRef="StartEvent_1" targetRef="TextAnnotation_025jrvi" />
    <bpmn:textAnnotation id="TextAnnotation_1omnfec">
      <bpmn:text>Prüfung ob Anzahl der Exemplare = Zahl (1-99) und Intervall = 1 oder 3</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0nxtmvk" sourceRef="Task_1gilgc4" targetRef="TextAnnotation_065dlid" />
    <bpmn:association id="Association_1dzemvc" sourceRef="Task_1gilgc4" targetRef="TextAnnotation_1ptf0lp" />
    <bpmn:association id="Association_1tgm24u" sourceRef="Task_1ysk49h" targetRef="TextAnnotation_1omnfec" />
    <bpmn:textAnnotation id="TextAnnotation_065dlid">
      <bpmn:text>Prüfung Anzahl der erwarteten BN mit Anzahl eingegangenen BN = 1 Jahr ausgehend vom Stichtag (12 Monate rückwirkend Beispiel: Prüfung am 01.02.2019 für 02/2018 - 01/2019</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1fqmc6w" sourceRef="Task_1pgxdzg" targetRef="TextAnnotation_0auheh5" />
    <bpmn:association id="Association_0btmvb9" sourceRef="Task_1h3pqtv" targetRef="TextAnnotation_17duho5" />
    <bpmn:textAnnotation id="TextAnnotation_0auheh5">
      <bpmn:text>Wenn Prüfung negativ ist, wird Fälligkeit um einen Tag verschoben - Starttag +1</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_17duho5">
      <bpmn:text>Wenn der BN Typ ungleich dem WErt "normal" ist, wird Fälligkeit um einen Tag verschoben - Starttag +1</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ujqegp">
      <bpmn:text>Ausgeglichenes Konto ode rnur eine verspätete Zahlung in 12 Monate</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_165mjw0" sourceRef="Task_124cyby" targetRef="TextAnnotation_0ujqegp" />
    <bpmn:association id="Association_0y7i3w8" sourceRef="Task_1h7cj61" targetRef="TextAnnotation_04exgng" />
    <bpmn:association id="Association_0h184qh" sourceRef="Task_1h7cj61" targetRef="TextAnnotation_1rli31e" />
    <bpmn:textAnnotation id="TextAnnotation_0dzrost">
      <bpmn:text>Auf Basis des in der Aufgabe angegebenen Intervalls wird die Aufgabe auf Wiedervorlage gesetzt zum 1. des Monats</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0xmqrlw" sourceRef="Task_0x0oblr" targetRef="TextAnnotation_0dzrost" />
    <bpmn:association id="Association_13aofw7" sourceRef="Task_1ks0tib" targetRef="TextAnnotation_0bddzlo" />
    <bpmn:association id="Association_0peftk6" sourceRef="Task_1ks0tib" targetRef="TextAnnotation_0oswcz9" />
    <bpmn:textAnnotation id="TextAnnotation_1rli31e">
      <bpmn:text>Wenn Konto wiederholt (&gt;= 2 x) nicht ausgeglichen war oder zum Stichtag ein negatives Saldo aufweist</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04exgng">
      <bpmn:text>Verspätete Zahlung sind erkennbar an Berechnung Säumniszuschlag + ggf. auf Mahngebühren oder der Zahlung nach dem drittletzten Arbeitstag des laufenden Monats</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_025jrvi">
      <bpmn:text>Starttrigger ist die 21c_kern Aufgabe "Arbeitgeber #12000 FZMB#Unbedenklichkeitsbescheinigung" die auf Anfrage vom AG manuell angelegt wird.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ptf0lp">
      <bpmn:text>Kann nicht 12 Monate rückwirkend geprüft werden, dann Prüfung ab Beginn Meldezeitraum</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0bddzlo">
      <bpmn:text>Feldname im 21c kern: "Statistik per heute Arbeitgeber" aus der Maske "Versicherungszeiten" hinzufügen in den Druckdatenstrom</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0oswcz9">
      <bpmn:text>Übergabe der Druckdaten an M/Text inkl. der Arbeitnehmeranzahl sowie Übergabe der Anzahl an Druck exemplare aus der Angabe in der Start-aufgabe</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
