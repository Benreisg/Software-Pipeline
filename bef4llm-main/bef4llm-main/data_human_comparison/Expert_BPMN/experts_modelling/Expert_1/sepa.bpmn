    <bpmn:textAnnotation id="TextAnnotation_06k8ejc">
      <bpmn:text>Person, gültige Unterschrift, vollständige IBAN, Eingangsdatum des Mandats, Ort der Unterschrift, Bestätigung, dass kein abweichender Kontoinhaber existiert</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0igacxp">
      <bpmn:text>Frist von 28 Tagen</bpmn:text>
    </bpmn:textAnnotation>
